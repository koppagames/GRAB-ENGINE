<UserControl x:Class="GrabEngine.Controls.SceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="clr-namespace:GrabEngine.Rendering"
             Focusable="True" Background="#FF1E1E1E">
    <Grid x:Name="SkyHost" ClipToBounds="True" Background="Transparent">
        <rendering:SkyBackdrop x:Name="SkyGradient" IsHitTestVisible="False"/>
        <Viewport3D x:Name="Viewport" ClipToBounds="True" Margin="0">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" FieldOfView="55" NearPlaneDistance="0.04" FarPlaneDistance="8000"/>
            </Viewport3D.Camera>
            <ModelVisual3D x:Name="LevelVisual"/>
            <ModelVisual3D x:Name="PrefabPreviewVisual"/>
            <ModelVisual3D x:Name="PlayerVisual"/>
            <ModelVisual3D x:Name="ParticleVisual"/>
        </Viewport3D>
        <!-- The gizmo has its own camera and depth buffer, composited over the scene.
             That keeps handles visible through blocks and gives them priority in hit
             testing without changing normal block selection. -->
        <Viewport3D x:Name="GizmoViewport" ClipToBounds="True" Margin="0">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="GizmoCamera" FieldOfView="55" NearPlaneDistance="0.04" FarPlaneDistance="8000"/>
            </Viewport3D.Camera>
            <ModelVisual3D x:Name="GizmoVisual"/>
            <!-- Brush ghosts live in the overlay viewport too, so a placement preview
                 remains readable even when the target cell is behind a block. -->
            <ModelVisual3D x:Name="BrushVisual"/>
            <ModelVisual3D x:Name="TerrainVisual"/>
            <ModelVisual3D x:Name="BuildVisual"/>
            <ModelVisual3D x:Name="MeasureVisual"/>
            <!-- Build validation markers sit in the overlay viewport so a red box is
                 visible even when the problem is inside or behind geometry. -->
            <ModelVisual3D x:Name="ValidationVisual"/>
            <!-- Live pathfinding route. It uses the overlay viewport so the route is
                 readable through walls while the agent is still hidden behind them. -->
            <ModelVisual3D x:Name="NavVisual"/>
            <ModelVisual3D x:Name="PathVisual"/>
        </Viewport3D>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#AA202020"
                BorderBrush="#FF3C3C3C" BorderThickness="1" CornerRadius="3" Padding="8,4" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ModeLabel" Text="Move" Foreground="#FFD0D0D0" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModeHint" Text="  •  RMB orbit   RMB + WASD fly   MMB pan   Wheel zoom   F focus" Foreground="#FF8A8A8A" FontSize="11"/>
            </StackPanel>
        </Border>
        <Border x:Name="MeasureBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                Background="#DD202020" BorderBrush="#FF8A6A20" BorderThickness="1" CornerRadius="3"
                Padding="9,5" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="MEASURE" Foreground="#FFFFD05A" FontSize="9.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="MeasureLabel" Text="Click two points to measure." Foreground="#FFE8E8E8" FontSize="11.5" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Background="#AA202020"
                BorderBrush="#FF3C3C3C" BorderThickness="1" CornerRadius="3" Padding="8,4" IsHitTestVisible="False">
            <TextBlock x:Name="StatsLabel" Text="" Foreground="#FF9A9A9A" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
