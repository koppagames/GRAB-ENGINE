<UserControl x:Class="GrabEngine.Controls.CodeEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="#FF1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#FF2B2B2B" BorderBrush="#FF3A3A3A" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <Button x:Name="CompileButton" DockPanel.Dock="Left" Content="▶ Compile" Padding="10,3" Margin="0,0,6,0"
                        Background="#FF2E6B3E" Foreground="#FFE8FFE8" BorderBrush="#FF3E8A52" Click="Compile_Click"/>
                <Button DockPanel.Dock="Left" Content="⌕ Problems" Padding="8,3" Margin="0,0,6,0" Click="Problems_Click"/>
                <TextBlock x:Name="HintText" DockPanel.Dock="Right" Foreground="#FF8C8C8C" FontSize="11"
                           VerticalAlignment="Center" Text="Ctrl+Space completion  •  F12 definition  •  Shift+F12 references  •  F2 rename  •  Ctrl+Shift+F format  •  F6 compile"/>
                <TextBlock x:Name="StatusText" Foreground="#FFB8B8B8" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
            </DockPanel>
        </Border>
        <avalonEdit:TextEditor x:Name="Editor" Grid.Row="1"
                               Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                               FontFamily="Cascadia Mono, Consolas" FontSize="13"
                               ShowLineNumbers="True" WordWrap="False"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                               LineNumbersForeground="#FF6E7681"
                               Padding="6,4"/>
        <Border Grid.Row="2" Background="#FF252526" BorderBrush="#FF3A3A3A" BorderThickness="0,1,0,0" Padding="6,2">
            <DockPanel>
                <TextBlock x:Name="GasCostText" DockPanel.Dock="Right" Foreground="#FF7FC8A0" FontSize="10.5"
                           FontFamily="Cascadia Mono, Consolas" Text="" ToolTip="GASM budget: instructions / 150 · connections / 10 · working registers"/>
                <TextBlock x:Name="FooterText" Foreground="#FF8A8A8A" FontSize="11" Text="Select a Code Block to edit its C# script."/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
